FROM registry.redhat.io/openshift/golang-builder:golang-builder-v1.26-rhel9 AS builder

ARG TARGETOS
ARG TARGETARCH
ARG TARGETPLATFORM

WORKDIR /workspace
COPY . .
WORKDIR /workspace/upstream/kueue
RUN ./build.sh

FROM registry.redhat.io/ubi9/ubi-minimal-pqc@sha256:d34666200b64d5a183c867487fd2f48ee8547eb18134e5647099970e26f08af9
WORKDIR /
COPY --from=builder /workspace/upstream/kueue/src/bin/manager /
USER 65532:65532

LABEL com.redhat.component="Kueue"
LABEL com.redhat.openshift.versions="v4.18-v4.19-v4.20-v4.21-v4.22-v4.23-v5.0"
LABEL name="kueue"
LABEL url="https://github.com/kubernetes-sigs/kueue"
LABEL vendor="Red Hat, Inc."
LABEL description="Kueue is a set of APIs and controller for job queueing. \
                    It is a job-level manager that decides when a job should \ 
                    be admitted to start (as in pods can be created) \
                    and when it should stop (as in active pods should be deleted)."
LABEL io.k8s.description="Kueue is a set of APIs and controller for job queueing. \
                    It is a job-level manager that decides when a job should \
                    be admitted to start (as in pods can be created) \
                    and when it should stop (as in active pods should be deleted)."
LABEL summary="Kueue is a set of APIs and controller for job queueing. \
                    It is a job-level manager that decides when a job should \
                    be admitted to start (as in pods can be created) \
                    and when it should stop (as in active pods should be deleted)."
LABEL io.k8s.display-name="Kueue"
LABEL io.openshift.tags="openshift,operand,kueue"
LABEL cpe="cpe:/a:redhat:kueue_operator:1.5::el9"
LABEL distribution-scope="public"
LABEL version="1.5.0"
LABEL release="1.5.0"

# Licenses

COPY --from=builder /workspace/LICENSE /licenses/LICENSE

ENTRYPOINT ["/manager"]
